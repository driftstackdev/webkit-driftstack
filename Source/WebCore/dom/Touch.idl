// https://w3c.github.io/touch-events/#touch-interface

[
    Conditional=TOUCH_EVENTS|DRIFTSTACK_TOUCH_STUBS,
    Exposed=Window
] interface Touch {
    readonly attribute double              clientX;
    readonly attribute double              clientY;
    readonly attribute double              screenX;
    readonly attribute double              screenY;
    readonly attribute double              pageX;
    readonly attribute double              pageY;
    // FIXME: `target` should not be nullable.
    readonly attribute EventTarget?        target;
    readonly attribute long                identifier;
    // iOS Safari exposes the UNPREFIXED standard names (verified vs real iPhone-17 apiEnum.proto.Touch,
    // 2026-06-01: the real Touch.prototype has force/radiusX/radiusY/rotationAngle + altitudeAngle/
    // azimuthAngle/touchType and NO webkit-prefixed names). Re-expose the existing impls under the
    // standard names via [ImplementedAs]; add the 3 iOS-only fields.
    [ImplementedAs=webkitRadiusX]       readonly attribute double             radiusX;
    [ImplementedAs=webkitRadiusY]       readonly attribute double             radiusY;
    [ImplementedAs=webkitRotationAngle] readonly attribute unrestricted float rotationAngle;
    [ImplementedAs=webkitForce]         readonly attribute unrestricted float force;
    readonly attribute double             altitudeAngle;
    readonly attribute double             azimuthAngle;
    readonly attribute DOMString          touchType;
};
