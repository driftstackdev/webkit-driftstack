/*
 * Wave 29-408.2 (Driftstack 2026-05-20): OverflowEvent restoration for Family A.
 *
 * Real iPhone Safari 18.6 (and 18.4) STILL exposes window.OverflowEvent as
 * `function` — a legacy WebKit event API removed from upstream WebCore
 * after a Q1 2024 cleanup CL. iOS 18 was built from an older branch where
 * the impl is still present. Driftstack restores a minimal modern-spec
 * version: Event subclass with 3 constants (HORIZONTAL/VERTICAL/BOTH) + 3
 * readonly attributes (orient, horizontalOverflow, verticalOverflow) +
 * standard constructor + EventInit dictionary.
 *
 * Gated by OverflowEventEnabled setting (default false on yaml) + Family A
 * archetype flip true. Family B keeps Safari-26.4 reality of OverflowEvent
 * being absent.
 *
 * Reference: legacy DOM3 OverflowEvent (https://www.w3.org/TR/DOM-Level-3-Events/#interface-OverflowEvent)
 */
[
    EnabledBySetting=OverflowEventEnabled,
    Exposed=Window
] interface OverflowEvent : Event {
    constructor([AtomString] DOMString type, optional OverflowEventInit eventInitDict = {});

    const unsigned short HORIZONTAL = 0;
    const unsigned short VERTICAL = 1;
    const unsigned short BOTH = 2;

    readonly attribute unsigned short orient;
    readonly attribute boolean horizontalOverflow;
    readonly attribute boolean verticalOverflow;
};

dictionary OverflowEventInit : EventInit {
    unsigned short orient = 0;
    boolean horizontalOverflow = false;
    boolean verticalOverflow = false;
};
