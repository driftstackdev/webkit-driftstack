/*
 * Copyright (C) 2026 Driftstack. All rights reserved.
 *
 * Driftstack: minimal stub of iOS Safari's GestureEvent so the JS-visible
 * window.GestureEvent constructor exposes 'function' typeof matching
 * iPhone Safari. iOS GestureEvent is documented at
 * https://developer.apple.com/documentation/webkitjs/gestureevent and
 * inherits UIEvent with scale + rotation properties for pinch-zoom and
 * rotation gestures. On Driftstack this is never dispatched (Mac fleet
 * has no touch input); the constructor exists purely for fingerprint
 * authenticity (file 109 hard rule — match real iPhone exactly).
 */

[
    Conditional=DRIFTSTACK_TOUCH_STUBS,
    Exposed=Window
] interface GestureEvent : UIEvent {
    readonly attribute float scale;
    readonly attribute float rotation;
    // W390: real iPhone-17 lists `target` as an OWN prop of GestureEvent.prototype (own-prop diff 12-vs-13,
    // pinpointed via the drillOwn capture vs real Safari 26.5; full-chain was already 52==52 because the fork
    // inherits target from Event). Redeclaring it re-homes it as own on GestureEvent.prototype, reusing the base
    // Event::target() impl (no new C++). Type matches Event.idl (`EventTarget?`). Undispatched → null on both.
    readonly attribute EventTarget? target;
    // iOS GestureEvent geometry/modifier fields + legacy init (match real iPhone Touch/Gesture prototype).
    readonly attribute double clientX;
    readonly attribute double clientY;
    readonly attribute double screenX;
    readonly attribute double screenY;
    readonly attribute boolean ctrlKey;
    readonly attribute boolean altKey;
    readonly attribute boolean shiftKey;
    readonly attribute boolean metaKey;
    undefined initGestureEvent();
};
