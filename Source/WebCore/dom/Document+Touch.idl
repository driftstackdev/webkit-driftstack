[
    // Driftstack: also emit under DRIFTSTACK_TOUCH_STUBS so the fork (which sets the stub flag, not full TOUCH_EVENTS)
    // exposes document.createTouch/createTouchList like a real iPhone (the d605cfd4 touch-stub pattern; DocumentTouch.{h,mm}
    // impl gates extended to match, and Touch/TouchList ctors already compile under the stub).
    Conditional=TOUCH_EVENTS|DRIFTSTACK_TOUCH_STUBS,
    ImplementedBy=DocumentTouch
] partial interface Document {
    // Driftstack (enum-order): createTouch/createTouchList were MOVED into the main Document.idl (right after
    // getCSSCanvasContext) so they emit at the real iPhone Document.prototype position (pos189-190) instead of the
    // supplemental-order position this partial produced (~pos209, BS-confirmed). Body intentionally empty; the
    // Conditional + ImplementedBy + Sources entry are kept so the DocumentTouch impl wiring is undisturbed.
};
