[
    Exposed=Window
] interface SVGAElement : SVGGraphicsElement {
    readonly attribute SVGAnimatedString target;

    // Driftstack: SVGAElement.hreflang/type are 26.2-added — real iPhone Safari 18.6 serves them undefined,
    // 26.2+ as function (dual-band apienum drillOwn 2026-07-08: absent@18.6, present@26.5). Their sibling
    // SVG2-anchor URI attributes rel/relList were already gated Safari262PrototypeMembersEnabled; hreflang/type
    // were missed by that audit. Gate them the same so Family-A (<26.2) hides them, 26.4/26.5 keep them.
    [Reflect, EnabledBySetting=Safari262PrototypeMembersEnabled] attribute DOMString hreflang;
    [Reflect, EnabledBySetting=Safari262PrototypeMembersEnabled] attribute DOMString rel;
    [SameObject, PutForwards=value, EnabledBySetting=Safari262PrototypeMembersEnabled] readonly attribute DOMTokenList relList;
    [Reflect, EnabledBySetting=Safari262PrototypeMembersEnabled] attribute DOMString type;
};

SVGAElement includes SVGURIReference;
