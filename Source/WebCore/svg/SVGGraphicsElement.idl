// https://svgwg.org/svg2-draft/types.html#InterfaceSVGGraphicsElement
[
    Exposed=Window
] interface SVGGraphicsElement : SVGElement {
    [SameObject] readonly attribute SVGAnimatedTransformList transform;

    // FIXME: `getBBox` should return a `DOMRect`.
    // FIXME: `getBBox` should take an `optional SVGBoundingBoxOptions` as a parameter.
    [ImplementedAs=getBBoxForBindings, NewObject] SVGRect getBBox();
    // FIXME: `getCTM` should return a `DOMMatrix?`.
    [ImplementedAs=getCTMForBindings, NewObject] SVGMatrix? getCTM();
    // FIXME: `getScreenCTM` should return a `DOMMatrix?`.
    [ImplementedAs=getScreenCTMForBindings, NewObject] SVGMatrix? getScreenCTM();

    // W392: nearestViewportElement / farthestViewportElement are SVG1.1 SVGLocatable readonly attributes that SVG2 removed
    // upstream, but real iPhone-17 Safari (26.4/26.5) still exposes them on SVGGraphicsElement.prototype (drillOwn own=9 vs
    // fork 7). Re-add to match: nearest reuses the still-present static helper; farthest mirrors historical WebKit. ImplementedAs
    // ...ForBindings avoids clashing with the internal static SVGGraphicsElement::nearestViewportElement(const SVGElement*).
    [ImplementedAs=nearestViewportElementForBindings] readonly attribute SVGElement? nearestViewportElement;
    [ImplementedAs=farthestViewportElementForBindings] readonly attribute SVGElement? farthestViewportElement;
};

SVGGraphicsElement includes SVGTests;
