PRODUCT_NAME = boringssl;

CLANG_WARN_BOOL_CONVERSION = YES;
CLANG_WARN_ENUM_CONVERSION = YES;
CLANG_WARN_INT_CONVERSION = YES;
GCC_WARN_64_TO_32_BIT_CONVERSION = NO;
COMBINE_HIDPI_IMAGES = NO;
ENABLE_STRICT_OBJC_MSGSEND = YES;

HEADER_SEARCH_PATHS = $(SRCROOT)/Source/third_party/boringssl/src/include;
INSTALL_PATH = $(INSTALL_PATH_PREFIX)$(WK_LIBRARY_INSTALL_PATH);
PUBLIC_HEADERS_FOLDER_PATH = $(INSTALL_PATH_PREFIX)$(WK_LIBRARY_INSTALL_PATH)/libwebrtc;
USE_HEADERMAP = NO;
GCC_WARN_UNUSED_FUNCTION = NO;

// Wave 29-499.159 — revert .158 hidden-visibility experiment. Since the
// -force_load into WebKit framework doesn't pull symbols in anyway
// (transitive libwebrtc.dylib already has them), the visibility flag is
// moot. Reverting to keep the libwebrtc build identical to upstream.
GCC_PREPROCESSOR_DEFINITIONS = OPENSSL_SMALL $(inherited);

EXCLUDED_SOURCE_FILE_NAMES[arch=arm64*] = *x86_64*-apple.S rsaz-avx2-apple.S;
EXCLUDED_SOURCE_FILE_NAMES[arch=x86_64*] = *armv8*-apple.S;

OTHER_LDFLAGS = $(inherited) $(SOURCE_VERSION_LDFLAGS);
